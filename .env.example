# ─────────────────────────────────────────────────────────────
# Hanabi client portal — environment
# Copy to `.env` and fill in. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon Postgres — direct (non-pooled) connection, used for migrations
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Public production URL used for canonicals, structured data, previews, and CMS CORS.
NEXT_PUBLIC_SITE_URL="https://www.tryhanabi.com"

# Payload CMS. PAYLOAD_DATABASE_URL is optional; when absent, Payload uses DATABASE_URL
# while keeping all CMS tables inside the separate `payload` Postgres schema.
PAYLOAD_DATABASE_URL=""
# Generate both secrets independently with: openssl rand -base64 32
PAYLOAD_SECRET="replace-me-with-a-32+-byte-random-string"
PAYLOAD_PREVIEW_SECRET="replace-me-with-another-random-string"
# Authorizes a serverless cron runner for scheduled publishing.
PAYLOAD_CRON_SECRET="replace-me-with-a-third-random-string"
# Leave false when using checked-in migrations. Enable only for a disposable local database.
PAYLOAD_DB_PUSH="false"

# Session signing secret. Generate: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-32+-byte-random-string"

# Admin login. Generate the hash with:
#   bun run scripts/hash-password.ts "your-admin-password"
# NOTE: escape every "$" as "\$" so env loaders don't expand it, e.g.
#   ADMIN_PASSWORD_HASH="\$2b\$12\$abc..."
ADMIN_PASSWORD_HASH="\$2b\$..."

# Bearer token the GitHub-commit AI monitor uses to POST updates.
# Generate: openssl rand -hex 24
UPDATES_API_TOKEN="replace-me"

# Cloudflare R2 (S3-compatible) for asset uploads
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hanabi-portal"
# Public base URL for the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL="https://assets.example.com"

# Payload blog media. These intentionally do not reuse the portal R2_* variables.
# If any value is missing, Payload stores uploads in the ignored local `media/` directory.
PAYLOAD_R2_BUCKET="hanabi-marketing-assets"
PAYLOAD_R2_ACCESS_KEY_ID=""
PAYLOAD_R2_SECRET_ACCESS_KEY=""
PAYLOAD_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
PAYLOAD_MEDIA_BASE_URL="https://assets.example.com"

# Optional custom delivery domain for public marketing images.
# Defaults to the managed URL for the hanabi-marketing-assets bucket.
NEXT_PUBLIC_MARKETING_ASSET_BASE_URL="https://assets.example.com"
